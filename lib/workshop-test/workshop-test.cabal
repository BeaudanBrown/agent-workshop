cabal-version: 3.0
name:          workshop-test
version:       0.1.0
synopsis:      Assertions shared by Agent Workshop test suites
build-type:    Simple

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Werror

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Workshop.Test
  build-depends:   base >=4.18 && <5
