cabal-version: 3.0
name:          agent-page
version:       0.2.0
synopsis:      Build self-contained HTML pages that present media and ask questions
build-type:    Simple

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Werror

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Workshop.AgentPage.Build
    Workshop.AgentPage.Cli
    Workshop.AgentPage.Document
    Workshop.AgentPage.Media
    Workshop.AgentPage.Parse
    Workshop.AgentPage.Render

  other-modules:   Paths_agent_page
  autogen-modules: Paths_agent_page
  build-depends:
    , base               >=4.18 && <5
    , base16-bytestring
    , base64-bytestring
    , bytestring
    , cryptohash-sha256
    , directory
    , filepath
    , process
    , text
    , workshop-cli

executable agent-page
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , base
    , agent-page

-- Parser and golden rendering run anywhere; the pipeline examples need
-- AGENT_PAGE_FFMPEG and AGENT_PAGE_FFPROBE. AGENT_PAGE_UPDATE_GOLDEN=1
-- rewrites test/golden after an intended rendering change.
test-suite agent-page-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , base
    , bytestring
    , directory
    , filepath
    , agent-page
    , process
    , temporary
    , text
    , unix
    , workshop-test
