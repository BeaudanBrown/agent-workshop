cabal-version: 3.0
name:          abrec
version:       0.1.0
synopsis:      Record read-aloud books and publish them as private podcast feeds
build-type:    Simple

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Werror

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Workshop.Abrec.Config
    Workshop.Abrec.Feed
    Workshop.Abrec.Library
    Workshop.Abrec.Main
    Workshop.Abrec.Media
    Workshop.Abrec.Publisher
    Workshop.Abrec.Site

  build-depends:
    , aeson
    , base               >=4.18 && <5
    , base16-bytestring
    , blaze-html
    , bytestring
    , containers
    , cryptohash-sha256
    , directory
    , filepath
    , ihp-hsx
    , process
    , stm
    , text
    , time
    , transformers
    , unix
    , workshop-cli

executable abrec
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , abrec
    , base

-- Media tests run the real ffmpeg and ffprobe from ABREC_FFMPEG and
-- ABREC_FFPROBE, with ABREC_FONT, and write a fake curl run by ABREC_TEST_SHELL.
test-suite abrec-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , abrec
    , base
    , directory
    , filepath
    , process
    , temporary
    , text
    , time
    , workshop-test
